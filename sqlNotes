DML : Data Manipulation Language
      ->insert
      ->update
      ->delete 
      
insert : insert into tableName
         values(__,__,___,__);  // values count need to match with column count 
               or
          insert into tableName (col1,col2,col4)
         values(val1,val2,val4); 
           or
          insert into tableName 
          values(__,__,___,__),
          values(__,__,___,__),
          values(__,__,___,__);

update : update tableName set colName=value ,colName=value where condition;

delete : delete from tableName where condition ; // based on condition it will delete record
         delete from tableName ;//it will delete entire table records 
  

